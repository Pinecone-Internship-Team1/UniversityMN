{
  "name": "@internship/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "bun@1.2.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"bun run service:dev\" \"bun run web:dev\"",
    "service:dev": "cd apps/rareAppMn/rareAppMn-service && wrangler dev",
    "service:deploy": "cd apps/rareAppMn/rareAppMn-service && wrangler deploy",
    "service:deploy:production": "cd apps/rareAppMn/rareAppMn-service && wrangler deploy --env production",
    "service:db:generate": "cd apps/rareAppMn/rareAppMn-service && drizzle-kit generate",
    "service:db:migrate:local": "cd apps/rareAppMn/rareAppMn-service && wrangler d1 migrations apply rareapp-db --local",
    "service:db:migrate:remote": "cd apps/rareAppMn/rareAppMn-service && wrangler d1 migrations apply rareapp-db --remote",
    "service:db:seed:local": "cd apps/rareAppMn/rareAppMn-service && curl -sf -X POST http://localhost:8787/dev/seed | head -c 2000",
    "web:dev": "cd apps/rareAppMn/rareAppMn-web && next dev"
  },
  "private": true,
  "dependencies": {
    "@clerk/backend": "^3.23.0",
    "@clerk/nextjs": "^7.9.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@urql/exchange-auth": "^3.0.0",
    "clsx": "^2.1.1",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.4.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.24.2",
    "lucide-react": "^1.47.0",
    "next": "~16.3.5",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "svix": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "^9.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "concurrently": "^10.0.5",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/next": "^23.2.1",
    "@nx/workspace": "23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.2.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.58.0",
    "wrangler": "^4.148.0"
  },
  "workspaces": [
    "apps/*/*",
    "libs/*/*"
  ]
}
