# CLI-side env vars (read by drizzle-kit and other tooling run outside the
# Worker runtime, via `dotenv`/your shell). Copy this file to `.env` --
# NEVER put real secrets in this .example file, since it (unlike `.env`) is
# committed to git.
#
# `drizzle-kit generate` needs none of this -- it only reads
# src/db/schema.ts. The CLOUDFLARE_* vars below are only needed for
# `drizzle-kit migrate` against a *remote* D1 database, once a real
# Cloudflare account is connected. Local migrations use
# `wrangler d1 migrations apply --local`, which needs none of this either.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Mirrors of the Worker runtime vars in `.dev.vars.example`, kept here too so
# any CLI script that loads `.env` directly sees the same local-dev mocks.
ENVIRONMENT=development
CLERK_SECRET_KEY=sk_test_mock_local_dev_only
CLERK_WEBHOOK_SECRET=whsec_mock_local_dev_only
ADMIN_CLERK_USER_IDS=user_mock_admin_local_dev
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
