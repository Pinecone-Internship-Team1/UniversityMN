{
  "name": "rareAppMn-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/rareAppMn/rareAppMn-web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/rareAppMn/rareAppMn-web"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/rareAppMn/rareAppMn-web"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "rareAppMn-web:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "rareAppMn-web:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "rareAppMn-web:build:production",
          "dev": false
        }
      }
    },
    "cf-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/rareAppMn/rareAppMn-web",
        "commands": [
          "next build",
          "opennextjs-cloudflare build --skipNextBuild"
        ],
        "parallel": false
      }
    },
    "cf-preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/rareAppMn/rareAppMn-web",
        "commands": [
          "next build",
          "opennextjs-cloudflare build --skipNextBuild",
          "opennextjs-cloudflare preview"
        ],
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/rareAppMn/rareAppMn-web",
        "commands": [
          "next build",
          "opennextjs-cloudflare build --skipNextBuild",
          "opennextjs-cloudflare deploy"
        ],
        "parallel": false
      }
    }
  }
}
