NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GraphQL endpoint for rareAppMn-service, a Cloudflare Worker
# (run locally with `bun run service:dev`, i.e. `wrangler dev`)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8787/

# From Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret.
# Required for /api/webhooks/clerk to verify incoming events.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
